<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:background="#F5F5F5"
    android:padding="12dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_stream_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stream Title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <!-- Duration -->
    <TextView
        android:id="@+id/tv_stream_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duration: 01:30:45"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- Date -->
    <TextView
        android:id="@+id/tv_stream_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: Jan 05, 2026"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- File Size -->
    <TextView
        android:id="@+id/tv_stream_file_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Size: 512 MB"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <!-- Viewers -->
    <TextView
        android:id="@+id/tv_stream_viewers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Max viewers: 150"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- Chat Count -->
    <TextView
        android:id="@+id/tv_stream_chat_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages: 342"
        android:textSize="12sp"
        android:textColor="#FF6B6B"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:spacing="8dp">

        <Button
            android:id="@+id/btn_stream_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_stream_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:backgroundTint="#FF5252" />

    </LinearLayout>

</LinearLayout>

