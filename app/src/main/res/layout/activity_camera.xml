<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Camera Preview -->
    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar" />

    <!-- Zoom Slider on Right Side -->
    <SeekBar
        android:id="@+id/zoom_slider"
        android:layout_width="24dp"
        android:layout_height="200dp"
        android:layout_below="@id/toolbar"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="100dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_vertical"
        android:thumb="@drawable/zoom_thumb"
        android:rotation="180" />

    <!-- Zoom Value Display -->
    <TextView
        android:id="@+id/tv_zoom_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/zoom_slider"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:background="#80000000"
        android:padding="4dp"
        android:text="1.0x"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Sensor Overlays (stacked on left side now since slider is on right) -->
    <!-- Gyroscope Data Overlay -->
    <LinearLayout
        android:id="@+id/gyroscope_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gyroscope"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gyro_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="X: 0.00°/s\nY: 0.00°/s\nZ: 0.00°/s"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Add other sensor overlays similarly on left side -->
    <!-- Accelerometer Data Overlay -->
    <LinearLayout
        android:id="@+id/accelerometer_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/gyroscope_overlay"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accelerometer"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_accel_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="X: 0.00 m/s²\nY: 0.00 m/s²\nZ: 0.00 m/s²"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Light Sensor Overlay -->
    <LinearLayout
        android:id="@+id/light_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/accelerometer_overlay"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Light Sensor"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_light_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 lux\nNormal"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Proximity Sensor Overlay -->
    <LinearLayout
        android:id="@+id/proximity_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/light_overlay"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proximity"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_proximity_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0.0 cm\nFAR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Magnetometer Overlay -->
    <LinearLayout
        android:id="@+id/magnetometer_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/proximity_overlay"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compass"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_magnet_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0°\nNorth"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <!-- Status TextView -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_centerHorizontal="true"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:padding="8dp"
        android:text="Initializing camera..."
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Recording Indicator -->
    <View
        android:id="@+id/recording_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_below="@id/toolbar"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_red"
        android:visibility="gone" />

    <!-- Recording Time Display -->
    <TextView
        android:id="@+id/tv_recording_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_alignParentStart="true"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:background="#80000000"
        android:padding="4dp"
        android:text="00:00"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Switch Camera Button -->
        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_switch_camera"
            android:contentDescription="Switch Camera" />

        <!-- Recording Button (Red Circle) -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/record_button_background">

            <ImageView
                android:id="@+id/btn_record"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_record_circle" />

        </FrameLayout>

        <!-- Floating Window Button -->
        <ImageButton
            android:id="@+id/btn_floating"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_floating"
            android:contentDescription="Floating Camera" />

    </LinearLayout>

    <!-- Zoom In/Out Buttons (Alternative to slider) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="#80000000"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="Zoom In" />

        <ImageButton
            android:id="@+id/btn_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#80000000"
            android:src="@drawable/ic_zoom_out"
            android:contentDescription="Zoom Out" />

    </LinearLayout>

</RelativeLayout>